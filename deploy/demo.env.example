# Copy to /etc/foliant/demo.env, fill in the two keys, then:
#   sudo chown root:foliant /etc/foliant/demo.env && sudo chmod 640 /etc/foliant/demo.env
# Both keys are TESTNET keys for wallets used by nothing else. Never put a key here that has
# ever held real funds.

# --- the chain and the deployed contracts (foliant/abi/deployments.json) ---
FOLIANT_RPC=https://api.avax-test.network/ext/bc/C/rpc
FOLIANT_ACCOUNTS=0xDB6940FBD9Dcf8AAD1aBB521B4b6790D0b579c92
FOLIANT_CHANNELS=0xa857d5EF74F63fd10BD786bf2d66EaA53736c976
FOLIANT_POOLS=0x26665c7Ad0a4272F87D1949745dD4B4743F53662
FOLIANT_TOKEN=0xadfAe994BF522D8ac3262AF2339568cA3a096cED

# --- the provider: receives settlements, signs receipts ---
PROVIDER_KEY=0x...

# --- the tap: funds a visitor so they do not have to find a faucet (demo/tap.py) ---
# a separate wallet, used by nothing else; the server refuses to start if it matches PROVIDER_KEY
FOLIANT_TAP_KEY=0x...
FOLIANT_TAP_AVAX=0.02
FOLIANT_TAP_TOKENS=1000
FOLIANT_TAP_PER_CLIENT_DAY=3
FOLIANT_TAP_PER_HOUR=20
FOLIANT_TAP_PER_DAY=100

# behind nginx, which replaces X-Forwarded-For with the peer address
FOLIANT_TRUST_PROXY=1

# where the gate's and the tap's state files live (the unit grants write access to this path only)
FOLIANT_STATE_DIR=/var/lib/foliant

# POST /settle needs this in an X-Settle-Key header; generate with `openssl rand -hex 32`
FOLIANT_SETTLE_KEY=

# price per call, in the token's smallest unit (6 decimals), and the pool the provider coordinates
FOLIANT_PRICE=3
FOLIANT_POOL_SALT=1
