# Settles everything the gate has accepted but not yet put on chain. Run by foliant-settle.timer;
# the server also settles on shutdown, so this is the periodic half of the same job.
[Unit]
Description=Foliant demo: settle accepted payments
After=foliant-demo.service

[Service]
Type=oneshot
User=foliant
Group=foliant
EnvironmentFile=/etc/foliant/demo.env
ExecStart=/usr/bin/curl -fsS --max-time 120 -X POST http://127.0.0.1:8402/settle -H "X-Settle-Key: ${FOLIANT_SETTLE_KEY}"
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
